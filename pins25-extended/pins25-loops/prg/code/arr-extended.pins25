// Built-in functions
fun exit(exitcode)
fun putint(intvalue)
fun putstr(straddr)

// Global arrays
var global_array = 10, 20, 30, 40, 50
var zero_array = 5 * 0
var mixed_array = 1, 2 * 5, 3, 4 * 7

// Helper function to print 3-element arrays
fun print_array_3(arr_ptr) =
    putstr("Array: \00"),
    putint(arr_ptr^), putstr(" \00"),
    arr_ptr = arr_ptr + 4,
    putint(arr_ptr^), putstr(" \00"),
    arr_ptr = arr_ptr + 4,
    putint(arr_ptr^), putstr("\n\00"),
    0

// Test basic array access using pointers
fun test_basic_arrays() =
    let
        var local_array = 100, 200, 300
        var ptr = 0
        var value = 0
    in
        putstr("=== Basic Array Tests ===\n\00"),

        // Access array elements using pointer arithmetic
        ptr = ^local_array,
        putstr("Array elements: \00"),

        // First element (index 0)
        value = ptr^,
        putint(value), putstr(" \00"),

        // Second element (index 1)
        ptr = ptr + 4,  // Move pointer by 4 bytes (INT_SIZE)
        value = ptr^,
        putint(value), putstr(" \00"),

        // Third element (index 2)
        ptr = ptr + 4,
        value = ptr^,
        putint(value), putstr("\n\00"),

        putstr("\n\00"),
        0
    end

// Test array modification
fun test_array_modification() =
    let
        var arr = 1, 2, 3, 4, 5
        var ptr = 0
    in
        putstr("=== Array Modification Tests ===\n\00"),

        putstr("Original array: \00"),
        ptr = ^arr,
        putint(ptr^), putstr(" \00"),
        ptr = ptr + 4,
        putint(ptr^), putstr(" \00"),
        ptr = ptr + 4,
        putint(ptr^), putstr(" \00"),
        ptr = ptr + 4,
        putint(ptr^), putstr(" \00"),
        ptr = ptr + 4,
        putint(ptr^), putstr("\n\00"),

        // Modify second element (index 1)
        ptr = ^arr,
        ptr = ptr + 4,  // Point to second element
        ptr^ = 99,      // Change 2 to 99

        putstr("After modification: \00"),
        ptr = ^arr,
        putint(ptr^), putstr(" \00"),
        ptr = ptr + 4,
        putint(ptr^), putstr(" \00"),
        ptr = ptr + 4,
        putint(ptr^), putstr(" \00"),
        ptr = ptr + 4,
        putint(ptr^), putstr(" \00"),
        ptr = ptr + 4,
        putint(ptr^), putstr("\n\00"),

        putstr("\n\00"),
        0
    end

// Test global array access
fun test_global_arrays() =
    let
        var ptr = 0
        var i = 0
    in
        putstr("=== Global Array Tests ===\n\00"),

        putstr("Global array elements: \00"),
        ptr = ^global_array,

        // Print all 5 elements
        i = 0,
        while i < 5 do
            putint(ptr^), putstr(" \00"),
            ptr = ptr + 4,
            i = i + 1
        end,
        putstr("\n\00"),

        putstr("\n\00"),
        0
    end

// Test zero-initialized array
fun test_zero_array() =
    let
        var ptr = 0
        var i = 0
    in
        putstr("=== Zero Array Tests ===\n\00"),

        putstr("Zero array (5 elements): \00"),
        ptr = ^zero_array,

        i = 0,
        while i < 5 do
            putint(ptr^), putstr(" \00"),
            ptr = ptr + 4,
            i = i + 1
        end,
        putstr("\n\00"),

        putstr("\n\00"),
        0
    end

// Test array as function parameter
fun test_array_parameters() =
    let
        var my_array = 7, 8, 9
    in
        putstr("=== Array Parameter Tests ===\n\00"),
        print_array_3(^my_array),
        putstr("\n\00"),
        0
    end

// Test array copying
fun test_array_copy() =
    let
        var source = 11, 22, 33
        var dest = 3 * 0
        var src_ptr = 0
        var dst_ptr = 0
        var i = 0
    in
        putstr("=== Array Copy Tests ===\n\00"),

        putstr("Source array: \00"),
        print_array_3(^source),

        putstr("Destination before copy: \00"),
        print_array_3(^dest),

        // Copy array
        src_ptr = ^source,
        dst_ptr = ^dest,
        i = 0,
        while i < 3 do
            dst_ptr^ = src_ptr^,
            src_ptr = src_ptr + 4,
            dst_ptr = dst_ptr + 4,
            i = i + 1
        end,

        putstr("Destination after copy: \00"),
        print_array_3(^dest),

        putstr("\n\00"),
        0
    end

// Test mixed initialization
fun test_mixed_arrays() =
    let
        var ptr = 0
    in
        putstr("=== Mixed Array Tests ===\n\00"),

        putstr("Mixed array (1, 2*5, 3, 4*7): \00"),
        ptr = ^mixed_array,
        putint(ptr^), putstr(" \00"),
        ptr = ptr + 4,
        putint(ptr^), putstr(" \00"),
        ptr = ptr + 4,
        putint(ptr^), putstr(" \00"),
        ptr = ptr + 4,
        putint(ptr^), putstr(" \00"),
        ptr = ptr + 16,
        putint(ptr^), putstr("\n\00"),

        putstr("\n\00"),
        0
    end

fun main() =
    putstr("===== ARRAY TESTS =====\n\n\00"),

    test_basic_arrays(),
    test_array_modification(),
    test_global_arrays(),
    test_zero_array(),
    test_array_parameters(),
    test_array_copy(),
    test_mixed_arrays(),

    putstr("===== ALL ARRAY TESTS COMPLETED =====\n\00"),
    exit(0)