{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Make Build",
            "type": "shell",
            "command": "C:\\Program Files\\Git\\bin\\bash.exe",
            "args": [
                "-c",
                "cd '/l/repos/fri/compiler-java/pins25/prg' && make all"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Make Run",
            "type": "shell",
            "command": "\"C:/Program Files/Git/bin/bash.exe\"",
            "args": [
                "-c",
                "cd '/l/repos/fri/compiler-java/pins25/prg' && make ${input:testName}"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "testName",
            "type": "promptString",
            "description": "Enter the test name (without .pins25 extension)"
        }
    ]
}