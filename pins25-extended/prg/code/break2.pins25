fun putint(int)

var round = 1
var attempt = 1

fun main() =
    while round <= 2 do
        putint(round * 1000),
        do
            putint(attempt),
            attempt = attempt + 1,
            if attempt > 3 then break end
        until attempt <= 5 end,
        round = round + 1,
        attempt = 1
    end,
    0